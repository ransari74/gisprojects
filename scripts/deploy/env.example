# Copy the values you need into the REAL env file at ../../../.env (i.e. one
# directory above this repo's checkout -- NOT inside the repo, so it never
# gets committed). scripts/deploy/lib.sh loads it automatically.
#
# Required:
pg_uri='postgres://user:password@host:port/dbname?sslmode=require'   # Aiven connection string
ecr_repo_uri='123456789012.dkr.ecr.us-east-1.amazonaws.com/gis/portfolio'  # PRIVATE ECR repo, no tag -- Lambda cannot pull from public.ecr.aws

# Optional -- sensible defaults are used if you leave these out:
aws_profile=''           # e.g. 'personal' -- set this if your machine has other AWS profiles configured
aws_region='us-east-1'
lambda_function_name='gis-portfolio-api'
lambda_role_name='gis-portfolio-api-lambda-role'
secret_key=''            # generated and appended here automatically by deploy-lambda.sh if blank/missing
cors_origins='http://localhost:5173'   # update once the frontend has a real URL, then re-run deploy-lambda.sh
seed_demo_users='true'
